# =========================================================
# Backend (FastAPI + SQLAlchemy + fastapi-users)
# Скопируйте в backend/.env и подставьте свои значения.
# =========================================================

# --- Секреты ---
# Секрет для подписи JWT. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string

# Алгоритм подписи JWT
ALGORITHM=HS256

# Время жизни токена в секундах (3600 = 1 час)
ACCESS_TOKEN_EXPIRE_SECONDS=3600

# --- База данных ---
# Вариант для Docker (хост "db" — имя сервиса из docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/livez

# Вариант для локального запуска без Docker (раскомментируйте и закомментируйте строку выше)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/livez

# Вариант вообще без PostgreSQL — SQLite-файл рядом с backend/:
# DATABASE_URL=sqlite+aiosqlite:///./data/db.sqlite3

# --- CORS ---
# Список origin через запятую. В dev достаточно localhost:5173.
CORS_ORIGINS=http://localhost:5173

# --- Cookie с токеном ---
# Включайте COOKIE_SECURE=true ТОЛЬКО если сайт открывается по HTTPS.
# При HTTP браузер не отправит cookie, и вход будет возвращать 401.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Загрузка файлов ---
# Максимальный размер картинки поста, МБ
MAX_UPLOAD_MB=10
# Максимальный размер аватара, МБ
MAX_AVATAR_MB=5
# Каталог для загруженных файлов (относительно backend/)
UPLOAD_DIR=uploads

# --- Отладка ---
# true — подробные логи и SQL-запросы; в проде false
DEBUG=true
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
