# =========================================================
# Backend (FastAPI + SQLAlchemy + fastapi-users)
# Скопируйте в backend/.env и заполните своими значениями
# =========================================================

# --- Секреты ---
# Секрет для JWT. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(64))"
# НЕ используйте дефолтное значение в продакшене.
SECRET_KEY=change-me-to-a-long-random-string

# Время жизни JWT-токена в секундах (по умолчанию 3600 = 1 час)
ACCESS_TOKEN_EXPIRE_SECONDS=3600

# --- База данных ---
# ВАЖНО: если запускаете через docker compose, хост = имя сервиса из docker-compose.yml (обычно "db")
# Если запускаете alembic/uvicorn ЛОКАЛЬНО (без Docker), используйте localhost
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/livez

# --- CORS ---
# Адреса фронтенда через запятую. В dev это localhost:5173.
# В проде сюда попадёт ваш реальный домен.
CORS_ORIGINS=http://localhost:5173

# --- Загрузка файлов ---
# Максимальный размер загружаемой картинки в мегабайтах
MAX_UPLOAD_MB=10

# Директория для uploads (внутри контейнера)
UPLOAD_DIR=uploads

# --- Режим разработки ---
# true — показывать подробные ошибки и Swagger
# false — продакшн
DEBUG=true

# --- Логирование ---
LOG_LEVEL=INFO