# =========================================================
# Docker Compose
# Скопируйте в .env в корне проекта (рядом с docker-compose.yml)
# =========================================================

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=livez

# Порт, на который пробрасывается БД (для подключения с хоста через psql/DBeaver)
POSTGRES_PORT=5432

# --- Порты приложений ---
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Образы ---
POSTGRES_IMAGE=postgres:16
PYTHON_IMAGE=python:3.11-slim
NODE_IMAGE=node:20-alpine