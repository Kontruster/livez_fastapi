# =========================================================
# Frontend (Vite + React)
# Скопируйте в frontend/.env
# =========================================================

# Адрес бэкенда для Vite-прокси.
# Внутри Docker-сети: имя сервиса из docker-compose (backend)
# При локальной разработке без Docker: http://localhost:8000
VITE_BACKEND_URL=http://backend:8000

# Куда монтируется фронт (используется только в info-сообщениях Vite)
VITE_PORT=5173